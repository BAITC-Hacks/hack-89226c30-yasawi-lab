# Local development launcher and backend CORS configuration.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Approved backend defaults. No weather API key is required.
WIND_PROJECT_TIMEZONE=Asia/Almaty
WIND_PROVIDER_TIMEOUT_SECONDS=15

# Frontend browser API configuration is in frontend/.env.example.
